+def _counterexamples(cases: dict[str, dict]) -> dict:
+    gcd = _field(cases["multiple_34"]["s2_rows"], "math_gcd", "/function/description")
+    method = _field(cases["multiple_35"]["s2_rows"], "calculate_lcm", "/method/description")
