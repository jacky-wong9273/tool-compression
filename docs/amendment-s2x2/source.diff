+
+def _third(word: str) -> str:
+    lowered = word.lower()
+    if lowered.endswith("s"):
+        return lowered
+    if lowered.endswith("y") and len(lowered) > 2 and lowered[-2] not in "aeiou":
+        return lowered[:-1] + "ies"
+    if lowered.endswith(("s", "x", "z", "ch", "sh")):
