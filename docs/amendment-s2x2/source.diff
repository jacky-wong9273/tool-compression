+    spent = [
+        f"`{item['case_id']}` {item['function_name']} ({item['class']}, SX2-U {item['deltas']['SX2-U']})"
+        for case in packet["cases"]
+        for item in case["cued_field_classes"]
+        if item["class"] in {"cue_exceeds_savings", "cue_cost_without_s2_savings"}
