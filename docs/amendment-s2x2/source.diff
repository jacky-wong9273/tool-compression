+        }, sort_keys=True))
+        return 0
+    if not args.authorize_peak:
+        print("refusing --live without --authorize-peak")
+        return 2
+    try:
+        run_live(args.bfcl_root, args.out, ceiling, clock, client=None, authorize_peak=True)
+    except UsxFlightRefused as exc:
+        print(str(exc))
+        return 1
+    return 0
