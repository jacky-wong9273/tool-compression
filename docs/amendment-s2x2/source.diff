+    split = packet["s2_edit_split"]["all_840"]
+    other = split["other_adopted_by_change_class"]
+    other_text = ", ".join(f"{name} {other[name]}" for name in sorted(other))
+    return [
+        "## Adopted S2 edits by rule effect",
+        "",
